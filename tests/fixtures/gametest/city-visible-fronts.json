{
  "version": 1,
  "id": "city-visible-fronts",
  "name": "Real distant fronts are present and approaching before the grace period ends",
  "seed": 42,
  "template": "building",
  "layout": "randomized",
  "rules": "force-fields",
  "city": true,
  "pacing": "study",
  "simulation": "game",
  "maxTicks": 60,
  "startTime": 0,
  "naturalSpawns": true,
  "entities": [{ "id": "human", "kind": "player", "x": 19.5, "y": 30.5 }],
  "deleted": [],
  "maps": [],
  "actions": [{ "tick": 30, "type": "checkpoint" }],
  "checks": [
    {
      "name": "Multiple actual zombie fronts already occupy the streets",
      "mode": "always",
      "query": { "type": "count", "kind": "zombie" },
      "op": "gte",
      "expected": 63
    },
    {
      "name": "The physical population stays bounded",
      "mode": "always",
      "query": { "type": "count", "kind": "zombie" },
      "op": "lte",
      "expected": 180
    },
    {
      "name": "No zombies materialize at the main entrance during grace",
      "mode": "always",
      "query": {
        "type": "region",
        "kind": "zombie",
        "floor": 0,
        "x1": 15,
        "x2": 29,
        "y1": 25,
        "y2": 40
      },
      "op": "eq",
      "expected": 0
    },
    {
      "name": "The lead zombie physically walks toward the building",
      "mode": "at",
      "tick": 60,
      "query": { "type": "property", "id": "z0", "field": "y" },
      "op": "lte",
      "expected": 325
    },
    {
      "name": "The lead is still correctly distant two seconds into grace",
      "mode": "at",
      "tick": 60,
      "query": { "type": "property", "id": "z0", "field": "y" },
      "op": "gte",
      "expected": 300
    }
  ]
}
