  "checks": [
    {
      "name": "The human jumps onto the visible roof parapet",
      "mode": "at",
      "tick": 24,
      "query": {
        "type": "property",
        "id": "human",
        "field": "elevation"
      },
      "op": "eq",
      "expected": 15.4
    },
    {
      "name": "Standing on the parapet is safe",
      "mode": "at",
      "tick": 24,
      "query": {
        "type": "property",
        "id": "human",
        "field": "hp"
      },
      "op": "eq",
      "expected": 100
    },
    {
      "name": "The human is not falling while supported by the parapet",
      "mode": "at",
      "tick": 24,
      "query": {
        "type": "property",
        "id": "human",
        "field": "falling"
      },
      "op": "eq",
      "expected": false
    },
    {
      "name": "The body is falling through open air during the checkpoint",
      "mode": "at",
      "tick": 45,
      "query": {
        "type": "property",
        "id": "human",
        "field": "falling"
      },
      "op": "eq",
      "expected": true
    },
    {
      "name": "The human is alive before hitting the ground",
      "mode": "at",
      "tick": 45,
      "query": {
        "type": "property",
        "id": "human",
        "field": "alive"
      },
      "op": "eq",
      "expected": true
    },
    {
      "name": "One damaging landing is recorded",
      "mode": "at",
      "tick": 120,
      "query": {
        "type": "event",
        "event": "fall"
      },
      "op": "eq",
      "expected": 1
    },
    {
      "name": "The fall reaches the actual ground",
      "mode": "at",
      "tick": 120,
      "query": {
        "type": "property",
        "id": "human",
        "field": "elevation"
      },
      "op": "eq",
      "expected": 0
    },
    {
      "name": "The fall ends on floor zero",
      "mode": "at",
      "tick": 120,
      "query": {
        "type": "property",
        "id": "human",
        "field": "floor"
      },
      "op": "eq",
      "expected": 0
    },
    {
      "name": "The 15.4 metre fall exhausts full health",
      "mode": "at",
      "tick": 120,
      "query": {
        "type": "property",
        "id": "human",
        "field": "hp"
      },
      "op": "eq",
      "expected": 0
    },
    {
      "name": "The roof parapet fall is lethal",
      "mode": "at",
      "tick": 120,
      "query": {
        "type": "property",
        "id": "human",
        "field": "alive"
      },
      "op": "eq",
      "expected": false
    },
    {
      "name": "The lethal fall ends the human run",
      "mode": "at",
      "tick": 120,
      "query": {
        "type": "humanEnded"
      },
      "op": "eq",
      "expected": true
    }
  ]
